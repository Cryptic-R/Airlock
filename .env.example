# ---- Agent identities (setup script fills these with random values; never commit .env) ----
ORCHESTRATOR_SEED_PHRASE=
READER_SEED_PHRASE=
BANK_SEED_PHRASE=

# ---- Agent names (shown on Agentverse) ----
ORCHESTRATOR_NAME=airlock
READER_NAME=airlock_reader
BANK_NAME=airlock_bank

# ---- ASI:One LLM (the planner): https://asi1.ai/dashboard/api-keys ----
ASI1_API_KEY=
ASI1_MODEL=asi1
ASI1_BASE_URL=https://api.asi1.ai/v1

# ---- Ports ----
ORCHESTRATOR_PORT=8010
READER_PORT=8011
BANK_PORT=8012

# ---- Reliability ----
HELPER_TIMEOUT_S=30

# ---- Agent Payment Protocol (settle approved bills in FET); testnet by default ----
ENABLE_PAYMENTS=false
FET_USE_TESTNET=true
BILL_TO_FET=0.001
